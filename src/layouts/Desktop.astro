---
// Page frame: document head, desktop background and taskbar. Pages put one
// or more windows in the default slot.
import '../styles/base.css';
import Taskbar from '../components/win95/Taskbar.astro';
import { site } from '../site';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Title shown on the taskbar button for the open window. */
  windowTitle?: string;
  noindex?: boolean;
  /**
   * Fit the window to the screen: it fills the space above the taskbar and
   * its body becomes a flex column, so a tool can give the leftover height to
   * one element (the page itself does not scroll). Only where there is room;
   * phones and short screens scroll as usual.
   */
  fit?: boolean;
}

const { title, description = site.description, windowTitle, noindex = false, fit = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${site.author.name}, ${site.author.callsign}`} />
    <meta name="theme-color" content="#008080" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <main class:list={['desktop', { 'desktop--fit': fit }]}>
      <slot />
    </main>
    <Taskbar windowTitle={windowTitle} />
  </body>
</html>

<style>
  .desktop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
    min-height: 100dvh;
    padding: var(--sp-6) var(--gutter) calc(var(--taskbar-h) + var(--sp-6));
  }

  .desktop > :global(.window) {
    width: min(100%, 64rem);
  }

  /* The same media query appears in tools that let an element fill the window */
  @media (min-width: 40.0625rem) and (min-height: 34rem) {
    .desktop--fit {
      height: 100dvh;
    }

    .desktop--fit > :global(.window) {
      flex: 1;
      min-height: 0;
    }

    .desktop--fit :global(.window__body) {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
  }

  /* Narrow screens: windows are maximized */
  @media (max-width: 40rem) {
    .desktop {
      padding: 0 0 calc(var(--taskbar-h) + var(--sp-3));
      gap: 0;
    }

    .desktop > :global(.window) {
      width: 100%;
      min-height: calc(100dvh - var(--taskbar-h) - var(--sp-3));
    }
  }
</style>
