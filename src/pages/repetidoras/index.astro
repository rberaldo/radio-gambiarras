---
import Desktop from '../../layouts/Desktop.astro';
import Icon from '../../components/win95/Icon.astro';
import Window from '../../components/win95/Window.astro';
import RepeaterTool from '../../tools/repetidoras/RepeaterTool.tsx';
import anatel from '../../../data/repeaters/anatel.json';
import meta from '../../../data/repeaters/meta.json';
import overlay from '../../../data/repeaters/overlay.json';
import { formatDate } from '../../lib/format.ts';
import { orphanedEntries, validateOverlay, type OverlayFile } from '../../lib/repeaters/overlay.ts';
import type { AnatelRepeatersFile } from '../../lib/repeaters/types.ts';

// A bad correction stops the deploy instead of reaching visitors. Corrections
// for repeaters Anatel dropped are skipped and only warned about.
const anatelIds = new Set((anatel as AnatelRepeatersFile).repeaters.map((r) => r.id));
const problems = validateOverlay(overlay as OverlayFile, anatelIds);
if (problems.length) throw new Error(`data/repeaters/overlay.json:\n  ${problems.join('\n  ')}`);
const orphans = orphanedEntries(overlay as OverlayFile, anatelIds);
if (orphans.length) console.warn(`overlay.json: ${orphans.length} entries for repeaters Anatel no longer lists (skipped): ${orphans.join(', ')}`);
---

<Desktop
  title="Repetidoras"
  windowTitle="Repetidoras"
  fit
  description="Mapa das repetidoras de 2 m e 70 cm do Brasil. Clique num lugar e baixe as repetidoras próximas para o CHIRP."
>
  <Window title="Repetidoras" current="/repetidoras">
    <Icon slot="icon" name="repetidoras" size={16} />
    {/* Rendered only in the browser: the map needs WebGL and the state comes from the URL. */}
    <RepeaterTool client:only="preact" />
    <Fragment slot="status">
      <span>Dados da Anatel de {formatDate(meta.updatedAt)}</span>
      <span>Licenciadas, não necessariamente no ar · Localizações são aproximadas</span>
    </Fragment>
  </Window>
</Desktop>
