---
// Map prototype for the user to review (roadmap M3.6). Not linked anywhere;
// removed when the real tool (M3.7) replaces it.
import Desktop from '../layouts/Desktop.astro';
import Icon from '../components/win95/Icon.astro';
import Window from '../components/win95/Window.astro';
import MapPrototype from '../tools/repetidoras/MapPrototype.tsx';
---

<Desktop title="Protótipo do mapa" windowTitle="Protótipo do mapa" fit noindex>
  <Window title="Repetidoras — protótipo do mapa" current="/prototipo-mapa">
    <Icon slot="icon" name="repetidoras" size={16} />
    <MapPrototype client:only="preact" />
    <Fragment slot="status">
      <span>Protótipo: só para avaliar o visual</span>
      <span>Dados da Anatel; posições aproximadas</span>
    </Fragment>
  </Window>
</Desktop>

<style>
  :global(.map-proto) {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }

  :global(.map-proto__map) {
    flex: 1;
    min-height: 60dvh;
    border: 1px solid var(--m-line);
    box-shadow: var(--m-shadow);
  }
</style>
