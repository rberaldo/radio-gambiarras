---
// Bottom taskbar: start menu with the tools, the current window's title and
// a clock. The start menu is a <details>, so it works without JavaScript.
import Icon from './Icon.astro';
import { metaPages, site } from '../../site';
import { toolHref, tools } from '../../tools';

interface Props {
  /** Title of the open window, shown as its taskbar button. */
  windowTitle?: string;
}

const { windowTitle } = Astro.props;
---

<footer class="taskbar">
  <details class="start">
    <summary class="start__button">
      <span class="start__logo"><Icon name="tux" size={16} /></span>
      Iniciar
    </summary>
    <nav class="start__menu" aria-label="Menu Iniciar">
      <div class="start__banner" aria-hidden="true">{site.name}</div>
      <ul role="list">
        {
          tools.map((tool) => {
            const href = toolHref(tool);
            return (
              <li>
                {href ? (
                  <a href={href}>{tool.title}</a>
                ) : (
                  <span class="start__disabled" aria-disabled="true">
                    {tool.title} <small>(em breve)</small>
                  </span>
                )}
              </li>
            );
          })
        }
        <li class="start__separator" role="separator"></li>
        {
          metaPages.map((page) => (
            <li>
              <a href={page.href}>{page.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </details>
  {windowTitle && <span class="taskbar__window">{windowTitle}</span>}
  <time class="taskbar__clock" aria-hidden="true"></time>
</footer>

<script>
  const start = document.querySelector<HTMLDetailsElement>('.start');
  if (start) {
    document.addEventListener('click', (event) => {
      if (start.open && !start.contains(event.target as Node)) start.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && start.open) {
        start.open = false;
        start.querySelector('summary')?.focus();
      }
    });
  }

  const clock = document.querySelector<HTMLTimeElement>('.taskbar__clock');
  if (clock) {
    const format = new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit' });
    const tick = () => {
      const now = new Date();
      clock.textContent = format.format(now);
      clock.dateTime = now.toISOString();
    };
    tick();
    setInterval(tick, 15_000);
  }
</script>

<style>
  .taskbar {
    position: fixed;
    z-index: 100;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    height: var(--taskbar-h);
    padding: var(--sp-1) var(--sp-2);
    background: var(--c-face);
    box-shadow: inset 0 1px 0 var(--c-light-inner), inset 0 2px 0 var(--c-light);
  }

  .start {
    position: relative;
  }

  .start__button {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    height: calc(var(--taskbar-h) - 2 * var(--sp-2));
    padding: 0 var(--sp-3);
    box-shadow: var(--bevel-raised);
    font-weight: bold;
    list-style: none;
    cursor: pointer;
  }

  .start__button::-webkit-details-marker {
    display: none;
  }

  .start[open] > .start__button {
    box-shadow: var(--bevel-pressed);
  }

  .start__button:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -5px;
  }

  /* Tux, because why not */
  .start__logo :global(.icon) {
    width: 20px;
    height: 20px;
    image-rendering: pixelated;
  }

  .start__menu {
    position: absolute;
    bottom: calc(100% + var(--sp-2));
    left: calc(-1 * var(--sp-1));
    display: flex;
    min-width: 15rem;
    max-width: calc(100vw - var(--sp-3));
    padding: 3px;
    background: var(--c-face);
    box-shadow: var(--bevel-window);
  }

  .start__banner {
    display: flex;
    align-items: flex-end;
    width: 1.75rem;
    padding: var(--sp-2) 0;
    background: linear-gradient(0deg, var(--c-title-active), var(--c-shadow-inner));
    color: var(--c-title-text);
    font-weight: bold;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    overflow: hidden;
  }

  .start__menu ul {
    flex: 1;
    margin: 0;
    padding: var(--sp-1) 0;
    list-style: none;
  }

  .start__menu a,
  .start__disabled {
    display: block;
    padding: var(--sp-3) var(--sp-4);
    color: var(--c-text);
    text-decoration: none;
  }

  .start__menu a:hover,
  .start__menu a:focus-visible {
    background: var(--c-select);
    color: var(--c-select-text);
  }

  .start__disabled {
    color: var(--c-text-disabled);
    text-shadow: 1px 1px 0 var(--c-text-disabled-emboss);
    cursor: not-allowed;
  }

  .start__separator {
    margin: var(--sp-2) var(--sp-1);
    border-top: 1px solid var(--c-shadow-inner);
    border-bottom: 1px solid var(--c-light);
  }

  .taskbar__window {
    flex: 0 1 12rem;
    min-width: 0;
    overflow: hidden;
    height: calc(var(--taskbar-h) - 2 * var(--sp-2));
    padding: 0 var(--sp-3);
    box-shadow: var(--bevel-pressed);
    background: var(--c-light-inner);
    font-weight: bold;
    line-height: calc(var(--taskbar-h) - 2 * var(--sp-2));
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .taskbar__clock {
    margin-left: auto;
    padding: var(--sp-1) var(--sp-3);
    box-shadow: var(--bevel-status);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
  }
</style>
